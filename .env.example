PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hospitalia
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=3d
CORS_ORIGIN=http://localhost:3000

# Optional for core startup; required to enable password-reset delivery.
RESEND_API_KEY=re_replace_with_your_key
EMAIL_FROM=Hospitalia <no-reply@your-verified-domain.example>
